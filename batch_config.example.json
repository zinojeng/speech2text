  "segment_duration_seconds": 300,
  "auto_split_large_files": true,
  "api_rate_limit_delay": 1.0,
  "api_timeout_seconds": 300,
  "enable_detailed_logging": true,
  "log_level": "INFO",
  "generate_processing_report": true
}