{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "speech2text",
  "main": "src/index.js",
  "compatibility_date": "2026-08-29",
  "containers": [
    {
      "class_name": "Speech2TextContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SPEECH2TEXT_CONTAINER",
        "class_name": "Speech2TextContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Speech2TextContainer"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
